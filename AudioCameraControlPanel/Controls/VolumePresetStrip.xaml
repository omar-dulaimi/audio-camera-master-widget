<UserControl x:Class="AudioCameraControlPanel.Controls.VolumePresetStrip"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <!-- Absolute presets: jump straight to a fixed volume. -->
        <WrapPanel Orientation="Horizontal">
            <Button Command="{Binding ZeroCommand, ElementName=Root}"
                    Style="{StaticResource PresetButtonStyle}">
                <TextBlock Text="0%" />
            </Button>
            <Button Command="{Binding ThirtyCommand, ElementName=Root}"
                    Style="{StaticResource PresetButtonStyle}">
                <TextBlock Text="30%" />
            </Button>
            <Button Command="{Binding ThirtyFiveCommand, ElementName=Root}"
                    Style="{StaticResource PresetButtonStyle}">
                <TextBlock Text="35%" />
            </Button>
            <Button Command="{Binding FortyCommand, ElementName=Root}"
                    Style="{StaticResource PresetButtonStyle}">
                <TextBlock Text="40%" />
            </Button>
            <Button Command="{Binding FortyFiveCommand, ElementName=Root}"
                    Style="{StaticResource PresetButtonStyle}">
                <TextBlock Text="45%" />
            </Button>
            <Button Command="{Binding SixtyCommand, ElementName=Root}"
                    Style="{StaticResource PresetButtonStyle}"
                    Margin="0">
                <TextBlock Text="60%" />
            </Button>
        </WrapPanel>

        <!-- Relative nudges: step the current volume up or down by a saved amount.
             Accent-tinted so they read differently from the presets above. -->
        <WrapPanel Orientation="Horizontal" Margin="0,8,0,0">
            <Button Command="{Binding DecrementCommand, ElementName=Root}"
                    Style="{StaticResource StepButtonStyle}"
                    ToolTip="Lower volume by the step amount">
                <TextBlock Text="{Binding Step, ElementName=Root, StringFormat=&#x2212;{0}}" />
            </Button>
            <Button Command="{Binding IncrementCommand, ElementName=Root}"
                    Style="{StaticResource StepButtonStyle}"
                    ToolTip="Raise volume by the step amount">
                <TextBlock Text="{Binding Step, ElementName=Root, StringFormat=+{0}}" />
            </Button>
            <TextBlock Text="Step"
                       Style="{StaticResource CaptionStyle}"
                       VerticalAlignment="Center"
                       Margin="6,0,6,0" />
            <ComboBox Style="{StaticResource StepComboBoxStyle}"
                      ItemsSource="{Binding StepOptions, ElementName=Root}"
                      SelectedItem="{Binding Step, ElementName=Root, Mode=TwoWay}"
                      ToolTip="Choose how much each +/- press changes the volume" />
        </WrapPanel>
    </StackPanel>
</UserControl>
